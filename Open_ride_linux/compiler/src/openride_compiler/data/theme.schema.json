{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideTheme",
  "description": "Thème visuel OpenRide (Format .world v1, §9 ; thème 2.0 en pack de biomes depuis le lot U1).",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": true,
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "surfaceLayer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "texture": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "$ref": "#/$defs/hexColor"
        },
        "scale_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "ambience": {
      "type": "object",
      "additionalProperties": true,
      "description": "Thème 1.2 (lot P1, utilisé par P9).",
      "properties": {
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "birds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "insects": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "fauna": {
      "type": "object",
      "additionalProperties": true,
      "description": "Thème 1.2 (lot P1, utilisé par P11) : densités de 0 à 1.",
      "properties": {
        "birds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "livestock": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deer": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "biomeId": {
      "enum": [
        "temperate_grassland",
        "temperate_forest",
        "farmland",
        "boreal_forest",
        "alpine",
        "tundra",
        "polar",
        "mediterranean",
        "steppe",
        "savanna",
        "sand_desert",
        "rock_desert",
        "jungle",
        "wetland",
        "coast",
        "volcanic"
      ]
    },
    "groundLayer": {
      "type": "object",
      "required": [
        "name",
        "role",
        "color"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "flat",
            "steep",
            "high"
          ],
          "description": "flat : sol des pentes douces ; steep : au-delà de slope_threshold_deg (projection triplanaire) ; high : au-dessus de high_line_m."
        },
        "color": {
          "$ref": "#/$defs/hexColor"
        },
        "texture": {
          "type": [
            "string",
            "null"
          ]
        },
        "normal": {
          "type": [
            "string",
            "null"
          ]
        },
        "scale_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "biome": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ground": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "layers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/groundLayer"
              }
            },
            "slope_threshold_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "high_line_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "blend_sharpness": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "vegetation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "species": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "weight"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "oak",
                      "beech",
                      "spruce",
                      "pine",
                      "birch",
                      "larch",
                      "olive",
                      "holm_oak",
                      "cypress",
                      "stone_pine",
                      "palm",
                      "acacia",
                      "baobab",
                      "cactus",
                      "tree_fern",
                      "reed",
                      "dwarf_shrub",
                      "vine_row"
                    ]
                  },
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "max_density_per_ha": {
              "type": "number",
              "minimum": 0
            },
            "treeline_m": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "water": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "color": {
              "$ref": "#/$defs/hexColor"
            },
            "turbidity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "sky": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fog_density": {
              "type": "number",
              "minimum": 0
            },
            "haze": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "light_tint": {
              "$ref": "#/$defs/hexColor"
            }
          }
        },
        "ambience": {
          "$ref": "#/$defs/ambience"
        },
        "fauna": {
          "$ref": "#/$defs/fauna"
        },
        "seasons": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "calendar": {
              "enum": [
                "four",
                "wet_dry",
                "polar",
                "none"
              ]
            },
            "offset_months": {
              "type": "number",
              "minimum": -6,
              "maximum": 6
            },
            "durations_months": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 12
              },
              "description": "Durée de chaque saison du calendrier, dans son ordre (four : printemps, été, automne, hiver ; wet_dry : saison sèche, saison des pluies ; polar : jour, nuit) ; somme 12."
            }
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rock_color": {
          "$ref": "#/$defs/hexColor"
        },
        "soil_color": {
          "$ref": "#/$defs/hexColor"
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hexColor"
          }
        },
        "roofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hexColor"
          }
        },
        "textures": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "color": {
          "$ref": "#/$defs/hexColor"
        },
        "texture": {
          "type": [
            "string",
            "null"
          ]
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[12]\\.[0-9]+$",
      "description": "1.x : un seul paysage (biome temperate_grassland). 2.0 : pack de biomes (default_biome, biomes, variants, surfaces)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "texture_levels": {
      "type": "array",
      "description": "Niveaux de textures du pack (lot P20) : chaque chemin de texture est cherché d'abord dans le dossier du niveau retenu, puis dans ceux des niveaux inférieurs, puis à la racine du thème. Liste vide : une seule taille.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "max_px",
          "dir"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "max_px": {
            "type": "integer",
            "enum": [
              64,
              128,
              256,
              512,
              1024,
              2048,
              4096,
              8192
            ]
          },
          "dir": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
          }
        }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "grass": {
          "$ref": "#/$defs/surfaceLayer"
        },
        "rock": {
          "$ref": "#/$defs/surfaceLayer"
        },
        "snow": {
          "$ref": "#/$defs/surfaceLayer"
        },
        "slope_threshold_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "snow_line_m": {
          "type": "number"
        },
        "blend_sharpness": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "texture": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "$ref": "#/$defs/hexColor"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "buildings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hexColor"
          }
        },
        "roofs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hexColor"
          }
        }
      }
    },
    "vegetation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "treeline_m": {
          "type": "number"
        },
        "max_density_per_ha": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sky": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sun_elevation_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fog_density": {
          "type": "number",
          "minimum": 0
        },
        "clouds": {
          "type": "object",
          "additionalProperties": true,
          "description": "Thème 1.2 (lot P1, utilisé par P6).",
          "properties": {
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "speed_factor": {
              "type": "number",
              "minimum": 0
            },
            "color": {
              "$ref": "#/$defs/hexColor"
            },
            "altitude_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "time_of_day": {
          "type": "object",
          "additionalProperties": true,
          "description": "Thème 1.2 (lot P1, utilisé en 2.0 par P7).",
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "real",
                "accelerated"
              ]
            },
            "hour": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 24
            },
            "factor": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": true,
      "description": "Thème 1.2 (lot P1, utilisé par P8).",
      "properties": {
        "kind": {
          "enum": [
            "clear",
            "mist",
            "rain",
            "snow"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "morning_mist": {
          "type": "boolean"
        }
      }
    },
    "season": {
      "enum": [
        "spring",
        "summer",
        "autumn",
        "winter"
      ],
      "description": "Thème 1.2 (lot P1, utilisé en 2.0 par P18)."
    },
    "wind": {
      "type": "object",
      "additionalProperties": true,
      "description": "Thème 1.2 (lot P1) : vent lu quand [wind] mode = \"theme\", et vent décoratif de l'engine sans champ wind dans state.",
      "properties": {
        "speed_kmh": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "from_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "gust_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "ambience": {
      "$ref": "#/$defs/ambience"
    },
    "fauna": {
      "$ref": "#/$defs/fauna"
    },
    "default_biome": {
      "$ref": "#/$defs/biomeId",
      "description": "Thème 2.0 (lot U1) : biome d'une tuile sans couche biome ; temperate_grassland si absent."
    },
    "biomes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/biomeId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/biome"
      },
      "description": "Thème 2.0 (lot U1) : un objet par biome ; un biome absent prend les valeurs 1.x du thème (terrain, vegetation, sky, ambience, fauna)."
    },
    "variants": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "gres_rose",
          "calcaire_blanc",
          "granite_gris",
          "schiste_sombre",
          "basalte",
          "laterite_rouge",
          "craie",
          "tuile_ronde",
          "ardoise",
          "tuile_plate",
          "pierre_seche",
          "toit_plat_blanc",
          "bois"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/variant"
      },
      "description": "Thème 2.0 (lot U1) : variantes régionales ; roches et terres (rock_color, soil_color) ou architecture (walls, roofs)."
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compacted": {
          "$ref": "#/$defs/surface"
        },
        "gravel": {
          "$ref": "#/$defs/surface"
        },
        "dirt": {
          "$ref": "#/$defs/surface"
        }
      },
      "description": "Thème 2.0 (lot U1) : ruban des routes non revêtues (lot U22)."
    }
  }
}
