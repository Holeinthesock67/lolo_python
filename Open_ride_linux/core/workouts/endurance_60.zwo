<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>OpenRide</author>
    <name>Endurance Z2 (60 min)</name>
    <description>Échauffement 10 min, 45 min à 65 % FTP, retour au calme 5 min.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.65"/>
        <SteadyState Duration="2700" Power="0.65"/>
        <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45"/>
    </workout>
</workout_file>
