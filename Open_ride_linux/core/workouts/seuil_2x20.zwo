<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>OpenRide</author>
    <name>Seuil 2 × 20 min</name>
    <description>Échauffement 10 min, 2 × 20 min à 97 % FTP avec 5 min de récupération à 55 %, retour au calme 5 min.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="300" OnPower="0.97" OffPower="0.55"/>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45"/>
    </workout>
</workout_file>
