<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>OpenRide</author>
    <name>PMA 5 × 3 min</name>
    <description>Échauffement 10 min, 5 × 3 min à 115 % FTP avec 3 min à 50 % (IntervalsT), retour au calme 5 min.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.50"/>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45"/>
    </workout>
</workout_file>
