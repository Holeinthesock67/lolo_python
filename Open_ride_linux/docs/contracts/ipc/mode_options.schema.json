{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideModeOptionsMessage",
  "description": "Révision 1.7 (lot GP2) : options d'un mode, réponse à `list_mode_options` et `set_mode_option` (règles du mode WTF, objets du Grand Prix).",
  "type": "object",
  "required": [
    "type",
    "v",
    "mode",
    "options"
  ],
  "properties": {
    "type": {
      "const": "mode_options"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "wtf",
        "grandprix"
      ]
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "family",
          "on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "pitch": {
            "type": "string"
          },
          "on": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
