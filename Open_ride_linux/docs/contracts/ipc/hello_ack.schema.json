{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideHelloAckMessage",
  "type": "object",
  "required": [
    "type",
    "v",
    "core_version",
    "config"
  ],
  "properties": {
    "type": {
      "const": "hello_ack"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "core_version": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "required": [
        "ftp_w",
        "gears_total",
        "theme"
      ],
      "properties": {
        "ftp_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gears_total": {
          "type": "integer",
          "minimum": 2
        },
        "hr_max_bpm": {
          "type": "integer",
          "description": "Facultatif, révision 1.5 : fréquence cardiaque maximale (zones de FC du HUD).",
          "minimum": 1
        },
        "theme": {
          "type": "string"
        },
        "chart": {
          "type": "string",
          "enum": ["hidden", "reduced", "full"]
        },
        "difficulty_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "rogue": {
          "type": "object",
          "description": "Facultatif, révision 1.4 (série R) : présent si \"rogue\" est dans modes.",
          "required": [
            "w_prime_j",
            "w_prime_estimate_j",
            "cp_w",
            "objectives",
            "durations_min"
          ],
          "properties": {
            "w_prime_j": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "w_prime_estimate_j": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "cp_w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "objectives": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "endurance",
                  "threshold",
                  "vo2max"
                ]
              },
              "uniqueItems": true,
              "maxItems": 3
            },
            "durations_min": {
              "type": "array",
              "items": {
                "type": "integer",
                "enum": [
                  30,
                  45,
                  60,
                  90
                ]
              },
              "uniqueItems": true,
              "maxItems": 4
            },
            "chassis": {
              "type": "object",
              "description": "Facultatif (lot R9) : châssis débloqués et châssis choisi par défaut.",
              "required": [
                "unlocked",
                "selected"
              ],
              "properties": {
                "unlocked": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "uniqueItems": true,
                  "maxItems": 16
                },
                "selected": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            },
            "last": {
              "type": ["object", "null"],
              "description": "Facultatif, révision 1.5 (lot R13) : objectif et durée de la dernière run, relus dans le journal ; null avant la première run (l'engine montre alors l'avertissement du premier lancement).",
              "required": ["objective", "duration_min"],
              "properties": {
                "objective": {"type": "string", "enum": ["endurance", "threshold", "vo2max"]},
                "duration_min": {"type": "integer", "enum": [30, 45, 60, 90]}
              }
            },
            "lives": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "description": "Facultatif (lot R9) : vies en réserve."
            }
          }
        },
        "progression": {
          "$ref": "#/$defs/progression",
          "description": "Facultatif, révision 1.4 (série V) : absent si le core ne connaît pas la progression."
        },
        "open_world_dir": {
          "type": "string",
          "description": "Facultatif (révision 1.5, lot W1) : dossier des séances de monde ouvert ; `route_id` `ow:<id>` désigne `<open_world_dir>/<id>.world`."
        }
      }
    },
    "rev": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    }
  },
  "$defs": {
    "progression": {
      "type": "object",
      "required": [
        "level",
        "xp",
        "xp_level_start",
        "xp_next_level",
        "coins",
        "equipped",
        "avatar",
        "lives"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "xp_level_start": {
          "type": "integer",
          "minimum": 0
        },
        "xp_next_level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "coins": {
          "type": "integer",
          "minimum": 0
        },
        "equipped": {
          "type": "object",
          "required": [
            "frame",
            "wheels",
            "helmet",
            "kit",
            "socks",
            "glasses"
          ],
          "properties": {
            "frame": {
              "type": "string",
              "maxLength": 24
            },
            "wheels": {
              "type": "string",
              "maxLength": 24
            },
            "helmet": {
              "type": "string",
              "maxLength": 24
            },
            "kit": {
              "type": "string",
              "maxLength": 24
            },
            "socks": {
              "type": "string",
              "maxLength": 24
            },
            "glasses": {
              "type": "string",
              "maxLength": 24
            }
          },
          "additionalProperties": false
        },
        "avatar": {
          "$ref": "#/$defs/avatar"
        },
        "lives": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "avatar": {
      "type": "object",
      "required": [
        "height",
        "build",
        "skin",
        "hair",
        "hair_color",
        "kit_primary",
        "kit_secondary",
        "number"
      ],
      "properties": {
        "height": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "build": {
          "type": "string",
          "enum": [
            "slim",
            "medium",
            "strong"
          ]
        },
        "skin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "hair": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "hair_color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "kit_primary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "kit_secondary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "standing_grade_pct": {
          "type": "number",
          "description": "Lu dans [avatar] de config.toml (V6) ; transmis par hello_ack, non modifiable par set_avatar."
        },
        "standing_power_pct": {
          "type": "number",
          "description": "Lu dans [avatar] de config.toml (V6) ; transmis par hello_ack, non modifiable par set_avatar."
        }
      }
    }
  }
}
