{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideHelloAckMessage",
  "type": "object",
  "required": [
    "type",
    "v",
    "core_version",
    "config"
  ],
  "properties": {
    "type": {
      "const": "hello_ack"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "core_version": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "required": [
        "ftp_w",
        "gears_total",
        "theme",
        "difficulty_pct"
      ],
      "properties": {
        "ftp_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gears_total": {
          "type": "integer",
          "minimum": 2
        },
        "theme": {
          "type": "string"
        },
        "difficulty_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "open_world_dir": {
          "type": "string",
          "description": "Facultatif (révision 1.5 provisoire, lot W1) : dossier des séances de monde ouvert ; `route_id` `ow:<id>` désigne `<open_world_dir>/<id>.world`."
        }
      }
    }
  }
}
