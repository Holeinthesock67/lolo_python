{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideInputMessage",
  "type": "object",
  "required": [
    "type",
    "v",
    "event"
  ],
  "properties": {
    "type": {
      "const": "input"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "event": {
      "type": "string",
      "enum": [
        "PLUS_SHORT",
        "MINUS_SHORT",
        "PLUS_LONG",
        "MINUS_LONG",
        "PLUS_UNCLEAR",
        "MINUS_UNCLEAR",
        "A_SHORT",
        "A_LONG",
        "Z_SHORT",
        "Z_LONG",
        "Y_SHORT",
        "LEFT_SHORT",
        "RIGHT_SHORT",
        "UP_SHORT",
        "DOWN_SHORT"
      ]
    },
    "latence_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Identifiant de l'appui suivi, seulement quand le core est lancé avec --latence ([log] latence, lot X7)"
    },
    "latence_t": {
      "type": "number",
      "description": "Heure murale (s) de l'envoi par le core, avec latence_id (lot X7)"
    }
  }
}
