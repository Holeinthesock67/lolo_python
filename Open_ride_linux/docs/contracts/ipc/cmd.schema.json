{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideCommandMessage",
  "type": "object",
  "required": [
    "type",
    "v",
    "cmd_id",
    "name",
    "args"
  ],
  "properties": {
    "type": {
      "const": "cmd"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "cmd_id": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "enum": [
        "select_route",
        "select_workout",
        "start",
        "pause",
        "resume",
        "end_session",
        "skip_block",
        "input_event",
        "list_routes",
        "list_workouts",
        "set_difficulty",
        "scan_devices",
        "identify_click_plus",
        "pair_devices",
        "list_settings",
        "set_setting",
        "list_imports",
        "create_workout",
        "import_workout",
        "list_route_imports",
        "import_route",
        "start_run",
        "rogue_resync",
        "list_garage",
        "equip",
        "buy",
        "set_avatar",
        "list_plans",
        "start_plan",
        "stop_plan",
        "accept_ftp",
        "start_open_world",
        "choose_branch",
        "world_search",
        "world_map",
        "world_regions",
        "world_pin",
        "set_ride_mode",
        "list_wtf_rules",
        "set_wtf_rule",
        "list_profiles",
        "select_profile",
        "create_profile",
        "rename_profile",
        "delete_profile",
        "list_contents",
        "install_content",
        "create_plan"
      ]
    },
    "args": {
      "type": "object"
    }
  }
}
