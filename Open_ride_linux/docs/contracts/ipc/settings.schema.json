{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideSettingsMessage",
  "description": "Réponse à cmd list_settings ou set_setting (révision 1.3, lots O3 et O4) : réglages proposés au menu ; un seul datagramme de 60 000 octets au plus, comme `plans` (contrat §2, révision 1.5, depuis le 30 octobre ; 4 096 avant).",
  "type": "object",
  "required": [
    "type",
    "v",
    "request_cmd_id",
    "items"
  ],
  "properties": {
    "type": {
      "const": "settings"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "request_cmd_id": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "group",
          "type",
          "value",
          "applies"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "label": {
            "type": "string",
            "maxLength": 32
          },
          "group": {
            "enum": [
              "rider",
              "ride",
              "graphics",
              "sound",
              "wind"
            ],
            "description": "Sous-écran de « Réglages » (révision 1.5)."
          },
          "type": {
            "enum": [
              "int",
              "choice"
            ]
          },
          "value": {
            "type": [
              "integer",
              "string"
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "unit": {
            "type": "string"
          },
          "applies": {
            "enum": [
              "next_session",
              "now"
            ]
          }
        }
      }
    }
  }
}
