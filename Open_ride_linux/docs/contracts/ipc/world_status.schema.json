{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideWorldStatusMessage",
  "description": "Préparation du monde ouvert (révision 1.5 provisoire, lot W1) ; 1 400 octets au plus.",
  "type": "object",
  "required": [
    "type",
    "v",
    "phase",
    "done_bytes",
    "total_bytes",
    "squares_ready",
    "squares_needed",
    "message"
  ],
  "properties": {
    "type": {
      "const": "world_status"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "phase": {
      "enum": [
        "dem",
        "osm",
        "tiles",
        "generate",
        "ready",
        "error"
      ]
    },
    "done_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "squares_ready": {
      "type": "integer",
      "minimum": 0
    },
    "squares_needed": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string",
      "maxLength": 200
    }
  }
}
