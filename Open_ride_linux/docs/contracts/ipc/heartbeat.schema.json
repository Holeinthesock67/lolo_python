{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideHeartbeatMessage",
  "type": "object",
  "required": [
    "type",
    "v",
    "seq"
  ],
  "properties": {
    "type": {
      "const": "heartbeat"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "fps": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}