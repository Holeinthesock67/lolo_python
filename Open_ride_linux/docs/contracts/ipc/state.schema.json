{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideStateMessage",
  "type": "object",
  "required": [
    "type",
    "v",
    "seq",
    "t",
    "session_state",
    "pause_reason",
    "trainer_status",
    "input_status",
    "mode",
    "route_id",
    "route_length_m",
    "s",
    "grade",
    "grade_sent",
    "power",
    "power_3s",
    "cadence",
    "hr",
    "gear",
    "gears_total",
    "lat",
    "lon",
    "alt",
    "erg",
    "summary",
    "last_cmd_id"
  ],
  "properties": {
    "type": {
      "const": "state"
    },
    "v": {
      "type": "number",
      "minimum": 0,
      "description": "Vitesse virtuelle en m/s. Exception du contrat v1 : dans state, v n'est pas la version (vérifiée par hello/hello_ack)."
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "t": {
      "type": "number",
      "minimum": 0
    },
    "session_state": {
      "type": "string",
      "enum": [
        "IDLE",
        "LOADING",
        "READY",
        "RUNNING",
        "PAUSED",
        "FINISHED",
        "ERROR"
      ]
    },
    "pause_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "user",
        "trainer_lost",
        "engine_lost",
        "recording_failed",
        "core_restarted",
        "world_data",
        null
      ]
    },
    "trainer_status": {
      "type": "string",
      "enum": [
        "CONNECTED",
        "RECONNECTING",
        "LOST",
        "MOCK"
      ]
    },
    "input_status": {
      "type": "string",
      "enum": [
        "CONNECTED",
        "LOST",
        "KEYBOARD"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "SIM",
        "ERG",
        "ROGUE"
      ]
    },
    "route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_length_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "s": {
      "type": "number"
    },
    "grade": {
      "type": "number"
    },
    "difficulty_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "grade_sent": {
      "type": "number"
    },
    "power": {
      "type": "number"
    },
    "power_3s": {
      "type": "number"
    },
    "cadence": {
      "type": "number"
    },
    "hr": {
      "type": [
        "integer",
        "null"
      ]
    },
    "gear": {
      "type": "integer",
      "minimum": 1
    },
    "gears_total": {
      "type": "integer",
      "minimum": 1
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "description": "null en mode ROGUE (révision 1.4)."
    },
    "lon": {
      "type": [
        "number",
        "null"
      ],
      "description": "null en mode ROGUE (révision 1.4)."
    },
    "alt": {
      "type": [
        "number",
        "null"
      ],
      "description": "null en mode ROGUE (révision 1.4)."
    },
    "erg": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "workout_name": {
          "type": "string"
        },
        "block_index": {
          "type": "integer",
          "minimum": 1
        },
        "block_count": {
          "type": "integer",
          "minimum": 1
        },
        "block_type": {
          "type": "string",
          "enum": [
            "warmup",
            "steady",
            "interval_on",
            "interval_off",
            "ramp",
            "cooldown"
          ]
        },
        "block_remaining_s": {
          "type": "number"
        },
        "block_total_s": {
          "type": "number"
        },
        "target_w": {
          "type": "number"
        },
        "next_target_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "bias_pct": {
          "type": "number"
        },
        "paused": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "workout",
            "free",
            "cadence"
          ]
        },
        "cadence_target_rpm": {
          "type": "integer",
          "minimum": 1
        },
        "cadence_low_rpm": {
          "type": "number"
        },
        "cadence_high_rpm": {
          "type": "number"
        },
        "cadence_zone": {
          "type": "string",
          "enum": [
            "low",
            "in",
            "high"
          ]
        }
      },
      "required": [
        "workout_name",
        "block_index",
        "block_count",
        "block_type",
        "block_remaining_s",
        "block_total_s",
        "target_w",
        "next_target_w",
        "bias_pct",
        "paused"
      ]
    },
    "summary": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "duration_s": {
          "type": "number"
        },
        "distance_m": {
          "type": "number"
        },
        "avg_power_w": {
          "type": "number"
        },
        "fit_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "np_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "intensity_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "tss": {
          "type": [
            "number",
            "null"
          ]
        },
        "elevation_gain_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_cadence_rpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_hr_bpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_power_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "blocks": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 24,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "number"
              },
              {
                "type": [
                  "number",
                  "null"
                ]
              }
            ]
          }
        },
        "blocks_truncated": {
          "type": "boolean"
        },
        "segments": {
          "type": "object",
          "description": "Facultatif, révision 1.4 (série T) : passages de la séance et maillots finaux.",
          "required": [
            "passes",
            "more",
            "jerseys"
          ],
          "properties": {
            "passes": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "segment_id",
                  "kind",
                  "time_s",
                  "with_powerup",
                  "pr",
                  "rank",
                  "rank_total",
                  "points"
                ],
                "properties": {
                  "segment_id": {
                    "type": "string",
                    "maxLength": 24
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "sprint",
                      "climb"
                    ]
                  },
                  "time_s": {
                    "type": "number"
                  },
                  "with_powerup": {
                    "type": "boolean"
                  },
                  "pr": {
                    "type": "boolean"
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rank_total": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "points": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "more": {
              "type": "boolean",
              "description": "Vrai si la séance a eu plus de 10 passages (les 10 derniers sont listés)."
            },
            "jerseys": {
              "$ref": "#/$defs/jerseys"
            }
          }
        },
        "rogue": {
          "type": "object",
          "description": "Facultatif, révision 1.4 (série R) : bilan de la run.",
          "required": [
            "result",
            "objective",
            "duration_min",
            "seed",
            "rooms_won",
            "rooms_fled",
            "rooms_skipped",
            "rooms_total",
            "defeats",
            "boss",
            "gold",
            "cards",
            "perfect_shifts",
            "unlocks"
          ],
          "properties": {
            "result": {
              "type": "string",
              "enum": [
                "victory",
                "defeat",
                "abandoned"
              ]
            },
            "objective": {
              "type": "string",
              "enum": [
                "endurance",
                "threshold",
                "vo2max"
              ]
            },
            "duration_min": {
              "type": "integer",
              "enum": [
                30,
                45,
                60,
                90
              ]
            },
            "seed": {
              "type": "integer"
            },
            "rooms_won": {
              "type": "integer",
              "minimum": 0
            },
            "rooms_fled": {
              "type": "integer",
              "minimum": 0
            },
            "rooms_skipped": {
              "type": "integer",
              "minimum": 0
            },
            "rooms_total": {
              "type": "integer",
              "minimum": 0
            },
            "defeats": {
              "type": "integer",
              "minimum": 0
            },
            "boss": {
              "type": "string",
              "enum": [
                "won",
                "fled",
                "not_reached"
              ]
            },
            "gold": {
              "type": "integer",
              "minimum": 0
            },
            "cards": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "maxLength": 24
              }
            },
            "perfect_shifts": {
              "type": "integer",
              "minimum": 0
            },
            "unlocks": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 24
              }
            }
          }
        },
        "ftp_test": {
          "type": [
            "object",
            "null"
          ],
          "description": "Facultatif, révision 1.3 (lot O12) : résultat d'une séance de test de FTP (lot O10) ; absent pour une autre séance.",
          "required": [
            "test",
            "ftp_w",
            "previous_ftp_w",
            "warnings",
            "reliable"
          ],
          "properties": {
            "test": {
              "enum": [
                "ramp"
              ]
            },
            "ftp_w": {
              "type": [
                "integer",
                "null"
              ]
            },
            "previous_ftp_w": {
              "type": [
                "integer",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "enum": [
                  "too_short",
                  "erratic_cadence",
                  "trainer_dropout",
                  "paused"
                ]
              }
            },
            "reliable": {
              "type": "boolean"
            }
          }
        },
        "wtf": {
          "type": "object",
          "description": "Révision 1.5 (lot WTF2) : bilan du mode WTF.",
          "required": [
            "points",
            "events"
          ],
          "properties": {
            "points": {
              "type": "integer"
            },
            "events": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "kata_size": {
              "type": "number"
            },
            "kata_count": {
              "type": "integer"
            }
          }
        },
        "survivor": {
          "type": "object",
          "description": "Révision 1.5 (lot DS2) : bilan du Dernier survivant.",
          "required": [
            "place",
            "of",
            "arches",
            "spacing_km",
            "eliminated",
            "winner"
          ],
          "properties": {
            "place": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Place du cycliste ; null si la séance s'arrête avant sa fin de course."
            },
            "of": {
              "type": "integer",
              "minimum": 3
            },
            "arches": {
              "type": "integer",
              "minimum": 2
            },
            "spacing_km": {
              "type": "number"
            },
            "eliminated": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "string",
                    "maxLength": 8
                  },
                  {
                    "type": "string",
                    "maxLength": 16
                  },
                  {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                ]
              },
              "description": "[arche, id, nom, retard en s sur l'avant-dernier], dans l'ordre des arches."
            },
            "winner": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 8
            }
          }
        }
      },
      "required": [
        "duration_s",
        "distance_m",
        "avg_power_w",
        "fit_path"
      ]
    },
    "last_cmd_id": {
      "type": "integer"
    },
    "devices": {
      "type": "object",
      "description": "Facultatif (révision 1.1) : une trame sur 30 et après chaque changement.",
      "required": [
        "trainer",
        "click",
        "hr"
      ],
      "properties": {
        "trainer": {
          "type": "object",
          "required": [
            "status",
            "name",
            "address"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONNECTED",
                "RECONNECTING",
                "LOST",
                "MOCK"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "address": {
              "type": [
                "string",
                "null"
              ]
            },
            "busy": {
              "type": "boolean",
              "description": "Facultatif (révision 1.5) : Control Point occupé par un autre appareil."
            }
          }
        },
        "click": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "side",
              "status",
              "battery_pct"
            ],
            "properties": {
              "side": {
                "type": "string",
                "enum": [
                  "plus",
                  "minus",
                  "single"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "CONNECTED",
                  "SEARCHING",
                  "LOST"
                ]
              },
              "battery_pct": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "hr": {
          "type": "object",
          "required": [
            "status",
            "source",
            "battery_pct"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONNECTED",
                "SEARCHING",
                "LOST",
                "NONE"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "strap",
                "trainer",
                null
              ]
            },
            "battery_pct": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "bots": {
      "type": "array",
      "maxItems": 5,
      "description": "Facultatif : concurrents virtuels (lot N9).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "s",
          "v",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 8
          },
          "name": {
            "type": "string",
            "maxLength": 16
          },
          "s": {
            "type": "number"
          },
          "v": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "constant",
              "ghost"
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "climber",
              "rouleur",
              "sprinter",
              "diesel",
              null
            ],
            "description": "Révision 1.4 : profil du bot (T12), null pour un bot à puissance constante."
          },
          "cp_w": {
            "type": "number",
            "minimum": 0,
            "description": "Révision 1.4 : puissance critique du bot (W)."
          },
          "mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Révision 1.4."
          },
          "wbal_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Révision 1.4 : réserve W' restante (%)."
          },
          "jersey": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "sprint",
              "kom",
              null
            ],
            "description": "Révision 1.4 : maillot porté (T14)."
          },
          "gap_s": {
            "type": "number",
            "description": "Révision 1.4 : écart en temps de passage (T16), positif si le bot est devant."
          },
          "out": {
            "type": "integer",
            "minimum": 1,
            "description": "Révision 1.5 (lot DS2) : Dernier survivant, arche de l'élimination du bot ; présent pendant les 10 s où il se range."
          }
        }
      }
    },
    "wind": {
      "type": "object",
      "description": "Facultatif, révision 1.3 (lot P1) : vent au point s, envoyé 2 fois par seconde, absent quand le vent est coupé.",
      "required": [
        "speed_mps",
        "from_deg",
        "head_mps",
        "gust"
      ],
      "properties": {
        "speed_mps": {
          "type": "number",
          "minimum": 0
        },
        "from_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "head_mps": {
          "type": "number"
        },
        "gust": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "draft": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.45,
      "description": "Facultatif, révision 1.3 (lot P1) : coefficient d'aspiration appliqué au cycliste (SRS §5), absent sans bot."
    },
    "draft_bot": {
      "type": "string",
      "maxLength": 8,
      "description": "Facultatif, révision 1.3 (lot P1) : id du bot (kind constant) qui abrite le cycliste."
    },
    "segment": {
      "type": "object",
      "description": "Facultatif, révision 1.4 (T4, T5) : segment en cours ou prochain.",
      "required": [
        "id",
        "kind",
        "category",
        "d_to_start_m",
        "elapsed_s",
        "gap_to_pr_s"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 24
        },
        "kind": {
          "type": "string",
          "enum": [
            "sprint",
            "climb"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "4",
            "3",
            "2",
            "1",
            "HC",
            null
          ]
        },
        "d_to_start_m": {
          "type": "number",
          "minimum": 0,
          "description": "0 dans le segment."
        },
        "elapsed_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "null avant le départ."
        },
        "gap_to_pr_s": {
          "type": [
            "number",
            "null"
          ],
          "description": "Écart au record, négatif si en avance ; null sans record ou avant le départ."
        }
      }
    },
    "powerup": {
      "type": "object",
      "description": "Facultatif, révision 1.4 (T6) : absent en ERG (T-Q2).",
      "required": [
        "held",
        "active",
        "remaining_s"
      ],
      "properties": {
        "held": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "light",
            "aero",
            "power",
            null
          ]
        },
        "active": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "light",
            "aero",
            "power",
            null
          ]
        },
        "remaining_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "jerseys": {
      "$ref": "#/$defs/jerseys",
      "description": "Facultatif, révision 1.4 (T14) : détenteurs des maillots pendant la séance."
    },
    "bot_ahead": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "Facultatif, révision 1.4 (T16) : id du voisin immédiat, ou null."
    },
    "bot_behind": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "Facultatif, révision 1.4 (T16) : id du voisin immédiat, ou null."
    },
    "rogue": {
      "type": "object",
      "description": "Facultatif, révision 1.4 (série R) : présent seulement en mode ROGUE.",
      "required": [
        "phase",
        "room_id",
        "room_index",
        "rooms_total",
        "archetype",
        "boss_phase",
        "s_room",
        "enemy_hp",
        "enemy_hp_max",
        "shield",
        "shield_max",
        "adrenaline",
        "w_bal_j",
        "w_prime_j",
        "posture",
        "firewall_gap_m",
        "gold",
        "windows",
        "hack",
        "overheat",
        "loot_focus",
        "events"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "WARMUP",
            "ROOM",
            "CORRIDOR",
            "BOSS",
            "RECOVERY",
            "COOLDOWN",
            "RESULTS"
          ]
        },
        "room_id": {
          "type": "integer",
          "minimum": 0
        },
        "room_index": {
          "type": "integer",
          "minimum": 1
        },
        "rooms_total": {
          "type": "integer",
          "minimum": 1
