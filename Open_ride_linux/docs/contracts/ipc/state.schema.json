{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideStateMessage",
  "type": "object",
  "required": [
    "type",
    "v",
    "seq",
    "t",
    "session_state",
    "pause_reason",
    "trainer_status",
    "input_status",
    "mode",
    "route_id",
    "route_length_m",
    "s",
    "grade",
    "grade_sent",
    "power",
    "power_3s",
    "cadence",
    "hr",
    "gear",
    "gears_total",
    "lat",
    "lon",
    "alt",
    "erg",
    "summary",
    "last_cmd_id"
  ],
  "properties": {
    "type": {
      "const": "state"
    },
    "v": {
      "type": "number",
      "minimum": 0,
      "description": "Vitesse virtuelle en m/s. Exception du contrat v1 : dans state, v n'est pas la version (vérifiée par hello/hello_ack)."
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "t": {
      "type": "number",
      "minimum": 0
    },
    "session_state": {
      "type": "string",
      "enum": [
        "IDLE",
        "LOADING",
        "READY",
        "RUNNING",
        "PAUSED",
        "FINISHED",
        "ERROR"
      ]
    },
    "pause_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "user",
        "trainer_lost",
        "engine_lost",
        "recording_failed",
        "core_restarted",
        null
      ]
    },
    "trainer_status": {
      "type": "string",
      "enum": [
        "CONNECTED",
        "RECONNECTING",
        "LOST",
        "MOCK"
      ]
    },
    "input_status": {
      "type": "string",
      "enum": [
        "CONNECTED",
        "LOST",
        "KEYBOARD"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "SIM",
        "ERG"
      ]
    },
    "route_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_length_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "s": {
      "type": "number"
    },
    "grade": {
      "type": "number"
    },
    "grade_sent": {
      "type": "number"
    },
    "power": {
      "type": "number"
    },
    "power_3s": {
      "type": "number"
    },
    "cadence": {
      "type": "number"
    },
    "hr": {
      "type": [
        "integer",
        "null"
      ]
    },
    "gear": {
      "type": "integer",
      "minimum": 1
    },
    "gears_total": {
      "type": "integer",
      "minimum": 1
    },
    "lat": {
      "type": "number"
    },
    "lon": {
      "type": "number"
    },
    "alt": {
      "type": "number"
    },
    "erg": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "workout_name": {
          "type": "string"
        },
        "block_index": {
          "type": "integer",
          "minimum": 1
        },
        "block_count": {
          "type": "integer",
          "minimum": 1
        },
        "block_type": {
          "type": "string",
          "enum": [
            "warmup",
            "steady",
            "interval_on",
            "interval_off",
            "ramp",
            "cooldown",
            "freeride"
          ]
        },
        "block_remaining_s": {
          "type": "number"
        },
        "block_total_s": {
          "type": "number"
        },
        "target_w": {
          "type": "number"
        },
        "next_target_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "bias_pct": {
          "type": "number"
        },
        "paused": {
          "type": "boolean"
        }
      },
      "required": [
        "workout_name",
        "block_index",
        "block_count",
        "block_type",
        "block_remaining_s",
        "block_total_s",
        "target_w",
        "next_target_w",
        "bias_pct",
        "paused"
      ]
    },
    "summary": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "duration_s": {
          "type": "number"
        },
        "distance_m": {
          "type": "number"
        },
        "avg_power_w": {
          "type": "number"
        },
        "fit_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "np_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "intensity_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "tss": {
          "type": [
            "number",
            "null"
          ]
        },
        "elevation_gain_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_cadence_rpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "avg_hr_bpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_power_w": {
          "type": [
            "number",
            "null"
          ]
        },
        "blocks": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 24,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "number"
              },
              {
                "type": [
                  "number",
                  "null"
                ]
              }
            ]
          }
        },
        "blocks_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "duration_s",
        "distance_m",
        "avg_power_w",
        "fit_path"
      ]
    },
    "last_cmd_id": {
      "type": "integer"
    },
    "devices": {
      "type": "object",
      "description": "Facultatif (révision 1.1) : une trame sur 30 et après chaque changement.",
      "required": [
        "trainer",
        "click",
        "hr"
      ],
      "properties": {
        "trainer": {
          "type": "object",
          "required": [
            "status",
            "name",
            "address"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONNECTED",
                "RECONNECTING",
                "LOST",
                "MOCK"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "address": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "click": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "side",
              "status",
              "battery_pct"
            ],
            "properties": {
              "side": {
                "type": "string",
                "enum": [
                  "plus",
                  "minus",
                  "single"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "CONNECTED",
                  "SEARCHING",
                  "LOST"
                ]
              },
              "battery_pct": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "hr": {
          "type": "object",
          "required": [
            "status",
            "source",
            "battery_pct"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONNECTED",
                "SEARCHING",
                "LOST",
                "NONE"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "strap",
                "trainer",
                null
              ]
            },
            "battery_pct": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "bots": {
      "type": "array",
      "maxItems": 5,
      "description": "Facultatif : concurrents virtuels (lot N9).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "s",
          "v",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 8
          },
          "name": {
            "type": "string",
            "maxLength": 16
          },
          "s": {
            "type": "number"
          },
          "v": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "constant",
              "ghost"
            ]
          }
        }
      }
    }
  }
}
