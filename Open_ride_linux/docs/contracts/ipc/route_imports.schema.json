{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideRouteImportsMessage",
  "description": "Réponse à cmd list_route_imports (révision 1.5, lot O23) : traces importables (GPX, FIT, TCX, archives Garmin), en parties de 60 000 octets au plus comme routes.",
  "type": "object",
  "required": [
    "type",
    "v",
    "request_cmd_id",
    "part",
    "parts",
    "items",
    "truncated"
  ],
  "properties": {
    "type": {
      "const": "route_imports"
    },
    "v": {
      "type": "integer",
      "const": 1
    },
    "request_cmd_id": {
      "type": "integer",
      "minimum": 0
    },
    "part": {
      "type": "integer",
      "minimum": 1
    },
    "parts": {
      "type": "integer",
      "minimum": 1
    },
    "truncated": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "path",
          "file",
          "source",
          "imported"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Chemin absolu, à renvoyer tel quel dans import_route."
          },
          "file": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Dossier d'origine affiché (Téléchargements, Bureau…)."
          },
          "imported": {
            "type": "boolean",
            "description": "Une trace du même nom de fichier est déjà dans le dossier des traces."
          }
        }
      }
    }
  }
}
