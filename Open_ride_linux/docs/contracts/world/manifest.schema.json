{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideWorldManifest",
  "description": "Manifeste d'un .world (Format .world v1, §2 et §11).",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "name",
    "origin",
    "projection",
    "route"
  ],
  "properties": {
    "format": {
      "const": "openride-world"
    },
    "format_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string"
    },
    "compiler": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "gpx": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpx_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "alt_m"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": "number"
        },
        "utm_zone": {
          "type": "string"
        }
      }
    },
    "projection": {
      "type": "string",
      "description": "« utm » pour un parcours compilé ; « local_equirectangular » pour les parcours synthétiques de démonstration."
    },
    "route": {
      "type": "object",
      "required": [
        "present",
        "file",
        "length_m",
        "ds_m",
        "n",
        "type"
      ],
      "properties": {
        "present": {
          "const": true
        },
        "version": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ds_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 2
        },
        "type": {
          "enum": [
            "open",
            "loop",
            "out_and_back"
          ]
        },
        "grade_clamped_points": {
          "type": "integer",
          "minimum": 0
        },
        "alt_source": {
          "type": "string",
          "description": "Origine de l'altitude de la route : « gpx » ou nom de la source MNT (format 1.1)."
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "present"
        ],
        "properties": {
          "present": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "properties": {
        "terrain": {
          "type": "object",
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "native_resolution_m": {
              "type": "number",
              "minimum": 0
            },
            "near_cell_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "far_cell_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "road_half_width_m": {
              "type": "number",
              "minimum": 0
            },
            "tiles": {
              "type": "object",
              "description": "Tuiles écrites, par niveau (format 1.1).",
              "properties": {
                "near": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "far": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "segments": {
          "type": "object",
          "description": "Facultative, format 1.3 (lot T1) : segments.json, sprints et montées.",
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            },
            "file": {
              "type": "string",
              "const": "segments.json"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "manual_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Segments déclarés dans <parcours>.segments.toml."
            }
          }
        },
        "roads": {
          "type": "object",
          "description": "Facultative, format 1.5 (lot P22) : dossier roads/, routes voisines du couloir de 400 m.",
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "osm_date": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "Fiche calculée du parcours (lot O15, champ facultatif, format_world_v1 §2.1). Recalculée à la lecture si absente ou d'une autre version.",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "gain_m": {
          "type": "number",
          "minimum": 0
        },
        "loss_m": {
          "type": "number",
          "minimum": 0
        },
        "alt_min_m": {
          "type": "number"
        },
        "alt_max_m": {
          "type": "number"
        },
        "max_grade_pct": {
          "type": "number"
        },
        "climbs": {
          "type": "integer",
          "minimum": 0
        },
        "main_climb": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "start_m": {
                  "type": "number"
                },
                "length_m": {
                  "type": "number"
                },
                "gain_m": {
                  "type": "number"
                },
                "avg_grade_pct": {
                  "type": "number"
                },
                "category": {
                  "enum": [
                    null,
                    "4",
                    "3",
                    "2",
                    "1",
                    "HC"
                  ]
                }
              }
            }
          ]
        },
        "duration_200w_s": {
          "type": "integer",
          "minimum": 0
        },
        "durations_s": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "library": {
      "type": "object",
      "description": "Fiche saisie (lot O15, champ facultatif) copiée du fichier <trace>.toml à la compilation.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "credits": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,29}$"
          }
        }
      }
    },
    "live": {
      "type": "boolean",
      "description": "Monde vivant (monde ouvert, §13) : la route et les couches s'allongent pendant la séance."
    },
    "origin_kind": {
      "enum": [
        "route_start",
        "utm_grid"
      ],
      "description": "« utm_grid » : origine au coin de la grille de 5 km de la zone UTM (§13). Absent : premier point de la route."
    },
    "grid": {
      "type": "object",
      "required": [
        "near_m",
        "far_m",
        "e0",
        "n0"
      ],
      "properties": {
        "near_m": {
          "const": 1000
        },
        "far_m": {
          "const": 5000
        },
        "e0": {
          "type": "number",
          "multipleOf": 5000
        },
        "n0": {
          "type": "number",
          "multipleOf": 5000
        }
      }
    }
  }
}
