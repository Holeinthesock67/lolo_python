{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRideWorldJunctions",
  "description": "Carrefours à venir d'un monde vivant (§13).",
  "type": "object",
  "required": [
    "version",
    "revision",
    "junctions"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\."
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "junctions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "s_m",
          "x",
          "z",
          "lock_s_m",
          "default",
          "chosen",
          "locked",
          "branches"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 24
          },
          "s_m": {
            "type": "number",
            "minimum": 0
          },
          "x": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "lock_s_m": {
            "type": "number"
          },
          "default": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "chosen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "locked": {
            "type": "boolean"
          },
          "branches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "index",
                "heading_deg",
                "angle_deg",
                "road_class",
                "grade_pct_500m",
                "dead_end",
                "preview"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "heading_deg": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "angle_deg": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "road_class": {
                  "enum": [
                    "p",
                    "s",
                    "t",
                    "m",
                    "c",
                    "k"
                  ]
                },
                "grade_pct_500m": {
                  "type": "number"
                },
                "dead_end": {
                  "type": "boolean"
                },
                "preview": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 51,
                      "items": {
                        "type": "number"
                      }
                    },
                    "y": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 51,
                      "items": {
                        "type": "number"
                      }
                    },
                    "z": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 51,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
