{
  "description": "Réglages en sous-écrans : FTP + 15 W enregistrée dans config.toml, annulation par Y, qualité appliquée tout de suite, ligne de version, retour à l'accueil.",
  "etapes": [
    {"ecran": "home", "delai": 15},
    {"choisir": "settings"},
    {"ecran": "settings", "titre": "Réglages", "elements": ["devices", "group:rider", "group:ride", "group:display", "group:sound", "group:wind", "version"]},
    {"choisir": "group:rider"},
    {"ecran": "settings_group", "groupe": "rider", "titre": "Réglages › Cycliste", "contient": ["FTP — 250 W"]},
    {"choisir": "set:rider.ftp_w"},
    {"ecran": "settings_group", "edition": true},
    {"appui": ["PLUS_SHORT", "PLUS_SHORT", "PLUS_SHORT"]},
    {"ecran": "settings_group", "contient": ["FTP — ◀ 265 W ▶"]},
    {"appui": "A_LONG"},
    {"ecran": "settings_group", "edition": false, "contient": ["FTP — 265 W"]},
    {"config": {"rider.ftp_w": 265}},
    {"note": "Y pendant la modification : valeur d'avant rendue, rien d'écrit",
     "choisir": "set:rider.mass_kg"},
    {"appui": ["PLUS_SHORT", "PLUS_SHORT", "Y_SHORT"]},
    {"ecran": "settings_group", "edition": false, "contient": ["Poids — 75 kg"]},
    {"config": {"rider.mass_kg": null}},
    {"appui": "Y_SHORT"},
    {"ecran": "settings", "focus": "group:rider"},
    {"choisir": "group:display"},
    {"ecran": "settings_group", "groupe": "display", "titre": "Réglages › Affichage"},
    {"choisir": "set:render.quality"},
    {"appui": ["PLUS_SHORT", "A_LONG"]},
    {"journal": "engine", "motif": "Qualité appliquée : medium"},
    {"config": {"render.quality": "medium"}},
    {"appui": "Y_SHORT"},
    {"ecran": "settings", "contient": ["OpenRide "]},
    {"appui": "Y_SHORT"},
    {"ecran": "home", "focus": "settings"}
  ]
}
