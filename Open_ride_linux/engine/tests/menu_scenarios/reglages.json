    {"appui": "Y_SHORT"},
    {"ecran": "settings", "focus": "group:rider"},
    {"choisir": "group:graphics"},
    {"note": "Lot NI2 : ni « Textures du décor » (suit la qualité), ni « Thème » (un seul), ni « Mois » (saisons et jour-nuit coupés)",
     "ecran": "settings_group", "groupe": "graphics", "titre": "Réglages › Graphisme", "contient": ["Qualité graphique", "Saisons — coupées"],
