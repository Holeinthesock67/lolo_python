    {"config": {"render.quality": "≠départ"}},
    {"note": "Compteur d'images/s détaillé (temps CPU et GPU, pour les essais) : non → oui → détaillé",
     "choisir": "set:render.fps"},
    {"appui": ["PLUS_SHORT", "PLUS_SHORT", "A_LONG"]},
    {"ecran": "settings_group", "edition": false, "contient": ["Afficher les images/s — détaillé"]},
    {"config": {"render.fps": "detail"}},
