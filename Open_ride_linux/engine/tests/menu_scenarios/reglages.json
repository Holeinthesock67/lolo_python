    {"capture": "ni2_graphisme"},
    {"choisir": "set:render.quality"},
    {"appui": ["PLUS_SHORT", "A_LONG"]},
    {"note": "qualité suivante de celle du départ (low par défaut, ou celle de --qualite) : appliquée tout de suite",
