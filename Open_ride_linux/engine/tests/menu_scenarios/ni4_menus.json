{
  "description": "Lot NI4 (audit des éléments inutiles du 21 novembre) : accueil sans « Session simulée », rangée dans Réglages › Appareils ; liste ERG sans « Saisir du QWKcode » ; Graphisme sans « Décor vivant » ; « Son : oui / non » en tête de Réglages › Son, volumes cachés quand le son est coupé. Captures ni4_*.",
  "entrainement": true,
  "etapes": [
    {"ecran": "home", "delai": 15, "absent": ["Session simulée"]},
    {"capture": "ni4_accueil"},
    {"choisir": "erg"},
    {"ecran": "workouts", "contient": ["Créer un entraînement (intervalles)", "Comment ça marche ?"], "absent": ["QWKcode"]},
    {"capture": "ni4_liste_erg"},
    {"appui": "Y_SHORT"},
    {"ecran": "home"},
    {"choisir": "settings"},
    {"choisir": "group:graphics"},
    {"ecran": "settings_group", "groupe": "graphics", "titre": "Réglages › Graphisme", "contient": ["Qualité graphique"], "absent": ["Décor vivant"]},
    {"capture": "ni4_graphisme"},
    {"appui": "Y_SHORT"},
    {"choisir": "group:sound"},
    {"ecran": "settings_group", "groupe": "sound", "titre": "Réglages › Son", "contient": ["Son — oui", "Général", "Ambiance"]},
    {"capture": "ni4_son_oui"},
    {"choisir": "set:audio.enabled"},
    {"appui": ["PLUS_SHORT", "A_LONG"]},
    {"ecran": "settings_group", "edition": false, "contient": ["Son — non (silence)"], "absent": ["Général", "Ambiance"]},
    {"config": {"audio.enabled": false}},
    {"capture": "ni4_son_non"},
    {"choisir": "set:audio.enabled"},
    {"appui": ["PLUS_SHORT", "A_LONG"]},
    {"ecran": "settings_group", "edition": false, "contient": ["Son — oui", "Général"]},
    {"config": {"audio.enabled": true}},
    {"appui": "Y_SHORT"},
    {"choisir": "devices"},
    {"note": "la recherche lancée à l'ouverture grise la ligne : on attend sa fin", "ecran": "pairing", "contient": ["Rechercher les appareils", "Session simulée (sans matériel)"], "delai": 30},
    {"capture": "ni4_appareils"},
    {"choisir": "sim"},
    {"ecran": "confirm", "titre": "Session simulée ? OpenRide redémarre sans matériel", "focus": "no"},
    {"choisir": "no"},
    {"ecran": "pairing"}
  ]
}
