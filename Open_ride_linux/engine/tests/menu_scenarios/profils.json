{
  "description": "Profils de joueurs (série MJ, lot MJ8) : « Qui roule ? » au démarrage avec deux profils, changement de profil sans relancer, création d'un profil au nom proposé, renommage par la grille, profil d'essai jamais proposé.",
  "fichiers": {
    "OpenRide/Profils/.migration": "fini\n",
    "OpenRide/Profils/cycliste-a/profil.toml": "[profil]\nid = \"cycliste-a\"\nnom = \"Cycliste A\"\ntype = \"joueur\"\n\n[rider]\nftp_w = 200\n",
    "OpenRide/Profils/cycliste-b/profil.toml": "[profil]\nid = \"cycliste-b\"\nnom = \"Cycliste B\"\ntype = \"joueur\"\n\n[rider]\nftp_w = 300\n"
  },
  "etapes": [
    {"ecran": "profiles", "titre": "Qui roule ?", "delai": 20},
    {"ecran": "profiles", "focus": "p:cycliste-a", "elements": ["p:cycliste-a", "p:cycliste-b", "new", "manage"], "delai": 10},
    {"choisir": "p:cycliste-b"},
    {"ecran": "home", "titre": "OpenRide — Cycliste B", "contient": ["Profil : Cycliste B"], "delai": 10},
    {"fichier": "OpenRide/.profil_actif"},
    {"choisir": "profile"},
    {"ecran": "profiles", "focus": "p:cycliste-b", "delai": 10},
    {"choisir": "new"},
    {"ecran": "profile_name", "titre": "Nouveau profil : Cycliste 3_"},
    {"appui": "A_LONG", "voies": ["click"]},
    {"touche": "Enter", "voies": ["clavier"]},
    {"choisir": "validate", "voies": ["souris"]},
    {"ecran": "home", "titre": "OpenRide — Cycliste 3", "delai": 10},
    {"fichier": "OpenRide/Profils/cycliste-3/profil.toml"},
    {"choisir": "profile"},
    {"ecran": "profiles", "delai": 10},
    {"choisir": "manage"},
    {"ecran": "profile_manage_list"},
    {"choisir": "p:cycliste-a"},
    {"ecran": "profile_manage", "elements": ["rename", "delete"]},
    {"choisir": "rename"},
    {"ecran": "profile_name", "titre": "Renommer : Cycliste A_"},
    {"appui": "Y_SHORT", "voies": ["click", "souris"]},
    {"touche": "Backspace", "voies": ["clavier"]},
    {"ecran": "profile_name", "titre": "Renommer : Cycliste _"},
    {"aller": "c:25", "voies": ["click"]},
    {"appui": "Z_SHORT", "voies": ["click"]},
    {"touche": "Z", "maj": true, "voies": ["clavier"]},
    {"choisir": "c:25", "voies": ["souris"]},
    {"ecran": "profile_name", "titre": "Renommer : Cycliste Z_"},
    {"appui": "A_LONG", "voies": ["click"]},
    {"touche": "Enter", "voies": ["clavier"]},
    {"choisir": "validate", "voies": ["souris"]},
    {"ecran": "profiles", "contient": ["Cycliste Z"], "delai": 10}
  ]
}
