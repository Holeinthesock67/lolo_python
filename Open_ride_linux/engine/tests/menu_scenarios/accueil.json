{
  "description": "Accueil : connexion des appareils puis accueil, tableau des boutons (§7.1), chaque entrée ouvre son écran et Y revient à l'accueil.",
  "canaux": ["clavier", "click", "souris"],
  "preparation": {"entrainements": true, "plans": true},
  "etapes": [
    {"attendre_ecran": "home", "delai": 15, "note": "appareils simulés reliés : l'écran de connexion passe seul à l'accueil"},
    {"ecran": "home", "titre": "OpenRide", "focus": "world",
     "elements": ["world", "ride", "erg", "open_world", "rogue", "plan", "ftp", "sim", "garage", "settings", "quit"]},
    {"capture": "accueil"},
    {"tableau": null, "note": "tableau des boutons sur l'accueil"},
    {"ouvrir": "world"}, {"ecran": "routes", "titre": "Parcours", "elements": ["demo", "_sort"]},
    {"bouton": "Y court"}, {"ecran": "home", "focus": "world"},
    {"ouvrir": "erg"}, {"ecran": "workouts", "elements": ["_sim", "erg_court", "_create", "_import"]},
    {"bouton": "Y court"}, {"ecran": "home", "focus": "erg"},
    {"ouvrir": "rogue"}, {"ecran": "rogue_start", "elements": ["objective", "duration", "wprime", "launch"]},
    {"bouton": "Y court"}, {"ecran": "home", "focus": "rogue"},
    {"ouvrir": "plan"}, {"ecran": "plans", "elements": ["plan:plan_banc"]},
    {"bouton": "Y court"}, {"ecran": "home", "focus": "plan"},
    {"ouvrir": "ftp"}, {"ecran": "ftp_test", "elements": ["ramp", "20min"]},
    {"bouton": "Y court"}, {"ecran": "home", "focus": "ftp"},
    {"ouvrir": "garage"}, {"ecran": "garage", "elements": ["bike", "outfit", "avatar"]},
    {"bouton": "Y court"}, {"ecran": "home", "focus": "garage"},
    {"ouvrir": "settings"}, {"ecran": "settings", "titre": "Réglages"},
    {"bouton": "Y court"}, {"ecran": "home", "focus": "settings"},
    {"ouvrir": "sim"}, {"ecran": "confirm", "focus": "no", "elements": ["no", "yes"], "titre_debut": "Session simulée"},
    {"ouvrir": "no"}, {"ecran": "home", "focus": "sim"},
    {"ouvrir": "quit"}, {"ecran": "confirm", "focus": "no"},
    {"bouton": "Y court", "note": "Y sur une confirmation : annule"}, {"ecran": "home", "focus": "quit"},
    {"ouvrir": "ride", "note": "sans parcours choisi, la session libre passe par la liste des parcours"},
    {"ecran": "routes"},
    {"bouton": "Y court"}, {"ecran": "home"},
    {"ouvrir": "open_world"}, {"monde_ouvert": true, "delai": 5},
    {"capture": "monde_ouvert"},
    {"bouton": "Y court", "canaux": ["click"]}, {"monde_ouvert": false, "ecran": "home", "canaux": ["click"]},
    {"bouton": "Y court", "canaux": ["clavier"]},
    {"monde_ouvert": false, "ecran": "home", "canaux": ["clavier"],
     "connu": "touche Y tapée dans la recherche du monde ouvert au lieu de revenir (main.gd _world_menu_key), contraire au §7.1"},
    {"bouton": "Y court", "canaux": ["souris"]},
    {"monde_ouvert": false, "ecran": "home", "canaux": ["souris"],
     "connu": "clic droit sans effet dans le monde ouvert : world_menu_view.gd ne lit pas la souris (menu_view.gd oui)"},
    {"touche": "Échap", "canaux": ["clavier", "souris"], "note": "Échap (Y court) ferme le monde ouvert"},
    {"touche": "Échap", "canaux": ["clavier", "souris"]},
    {"monde_ouvert": false, "ecran": "home", "canaux": ["clavier", "souris"]}
  ]
}
